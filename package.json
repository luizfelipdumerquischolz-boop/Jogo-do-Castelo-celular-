{
  "name": "coroa-de-pedra",
  "private": true,
  "version": "2.0.0-alpha",
  "description": "Jogo de estratégia medieval offline para celular (PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "artes": "vite-node scripts/gen-art-list.ts && vite-node scripts/gen-art-prompts.ts && vite-node scripts/gen-grid-requests.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
